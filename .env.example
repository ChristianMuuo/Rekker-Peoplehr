# ==============================================================================
# Rekker PeopleOS — Environment Configuration Template
# Never commit real credentials or secrets. Copy to .env for local use only.
# ==============================================================================

# --- Core Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Authentication mode: "clerk" (required in production) or "demo" (local sandbox only)
PEOPLEOS_AUTH_MODE=demo

# Default workspace organization ID
PEOPLEOS_ORGANIZATION_ID=rekker-demo

# Trust reverse proxy headers cleanly for rate limiting (false | true | hop-count)
PEOPLEOS_TRUST_PROXY=false

# Strict CORS origin allowlist (comma-separated exact origins, REQUIRED in production, no wildcard *)
PEOPLEOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

# --- PostgreSQL Database ------------------------------------------------------
# Required in production. Leave unset locally only when testing non-DB demo mode.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/peopleos

# --- Identity & Authentication (Clerk) ----------------------------------------
# Both keys are REQUIRED when NODE_ENV=production or PEOPLEOS_AUTH_MODE=clerk
# CLERK_SECRET_KEY=sk_live_replace_me
# CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# --- Field-Level PII Encryption (AES-256-GCM Key Ring) ------------------------
# Minimum 32 high-entropy characters REQUIRED in production. Do not reuse CLERK/DB secrets.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PEOPLEOS_ENCRYPTION_KEY=replace_with_64_hex_character_secret
PEOPLEOS_ENCRYPTION_KEY_ID=k1
# Optional comma-separated historical key rings for zero-downtime key rotation ("k0=<secret>")
# PEOPLEOS_ENCRYPTION_PREVIOUS_KEYS=

# --- AI & Machine Learning Services (Optional) --------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# PEOPLEOS_ML_URL=http://127.0.0.1:8001
# PEOPLEOS_PYTHON_BIN=services/ml-engine/.venv/Scripts/python.exe

# --- Safaricom Daraja M-Pesa B2C (Optional / Live Disbursements) --------------
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_TIMEOUT_URL=https://api.your-peopleos-domain.example/api/payroll/mpesa/timeout
# MPESA_RESULT_URL=https://api.your-peopleos-domain.example/api/payroll/mpesa/result

# --- Governance Overrides (Explicit Emergency Opt-In Only) --------------------
# Set to "true" ONLY if dual-control Maker-Checker approval must be bypassed intentionally
PEOPLEOS_ALLOW_SOLO_APPROVE=false

# --- Frontend Build Variables (Vite) ------------------------------------------
# VITE_API_BASE_URL=
# BASE_PATH=/
